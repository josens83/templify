// Templify Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 사용자
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  role          Role     @default(BUYER)
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  templates     Template[]
  orders        Order[]
  reviews       Review[]
  tickets       SupportTicket[]
  wishlist      Wishlist[]
  points        Point[]
  membership    Membership?
  refunds       Refund[]

  @@map("users")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

// 템플릿
model Template {
  id            String   @id @default(uuid())
  name          String
  description   String
  category      String
  price         Int
  image         String
  demoUrl       String
  downloads     Int      @default(0)
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  tags          String   // JSON array stored as string
  features      String   // JSON array stored as string
  files         String   // JSON array stored as string - file URLs
  author        String
  authorId      String
  lastUpdated   String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  seller        User     @relation(fields: [authorId], references: [id])
  orderItems    OrderItem[]
  reviews       Review[]
  wishlist      Wishlist[]

  @@map("templates")
}

// 주문
model Order {
  id            String      @id @default(uuid())
  userId        String
  total         Int
  status        OrderStatus @default(PENDING)
  paymentMethod String?
  paymentId     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  user          User        @relation(fields: [userId], references: [id])
  items         OrderItem[]
  refund        Refund?

  @@map("orders")
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

// 주문 아이템
model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  templateId  String
  price       Int
  createdAt   DateTime @default(now())

  // Relations
  order       Order    @relation(fields: [orderId], references: [id])
  template    Template @relation(fields: [templateId], references: [id])

  @@map("order_items")
}

// 리뷰
model Review {
  id          String   @id @default(uuid())
  templateId  String
  userId      String
  rating      Int
  comment     String
  helpful     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  template    Template @relation(fields: [templateId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@map("reviews")
}

// 찜하기
model Wishlist {
  id          String   @id @default(uuid())
  userId      String
  templateId  String
  createdAt   DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id])
  template    Template @relation(fields: [templateId], references: [id])

  @@unique([userId, templateId])
  @@map("wishlists")
}

// 고객지원 티켓
model SupportTicket {
  id          String        @id @default(uuid())
  userId      String
  subject     String
  message     String
  category    String
  status      TicketStatus  @default(OPEN)
  priority    Priority      @default(MEDIUM)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  user        User          @relation(fields: [userId], references: [id])
  replies     TicketReply[]

  @@map("support_tickets")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// 티켓 답변
model TicketReply {
  id          String   @id @default(uuid())
  ticketId    String
  message     String
  isStaff     Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  ticket      SupportTicket @relation(fields: [ticketId], references: [id])

  @@map("ticket_replies")
}

// 환불
model Refund {
  id          String       @id @default(uuid())
  orderId     String       @unique
  userId      String
  reason      String
  status      RefundStatus @default(PENDING)
  amount      Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  order       Order        @relation(fields: [orderId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@map("refunds")
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

// 포인트
model Point {
  id          String      @id @default(uuid())
  userId      String
  amount      Int
  type        PointType
  description String
  createdAt   DateTime    @default(now())

  // Relations
  user        User        @relation(fields: [userId], references: [id])

  @@map("points")
}

enum PointType {
  EARNED
  SPENT
  EXPIRED
}

// 멤버십
model Membership {
  id          String         @id @default(uuid())
  userId      String         @unique
  tier        MembershipTier
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  user        User           @relation(fields: [userId], references: [id])

  @@map("memberships")
}

enum MembershipTier {
  BASIC
  PREMIUM
  VIP
}

// 쿠폰
model Coupon {
  id          String       @id @default(uuid())
  code        String       @unique
  discount    Int          // percentage or amount
  type        DiscountType
  minPurchase Int?
  maxUses     Int?
  usedCount   Int          @default(0)
  expiresAt   DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("coupons")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// 뉴스레터 구독자
model Newsletter {
  id            String   @id @default(uuid())
  email         String   @unique
  subscribedAt  DateTime @default(now())

  @@map("newsletters")
}
